<%@ page contentType="text/html;charset=UTF-8" language="java" %>

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Contact - GetHostel</title>

    <link rel="stylesheet"
          href="${pageContext.request.contextPath}/css/style.css">

</head>

<body>


<!-- =====================================================
     HEADER
===================================================== -->

<header>

    <div class="logo">

        <img src="${pageContext.request.contextPath}/images/logo.png"
             alt="GetHostel Logo">

        <h1>GetHostel</h1>

    </div>


    <nav>

        <a href="${pageContext.request.contextPath}/">
            Home
        </a>

        <a href="${pageContext.request.contextPath}/boys">
            Boys Hostels
        </a>

        <a href="${pageContext.request.contextPath}/girls">
            Girls Hostels
        </a>

        <a href="${pageContext.request.contextPath}/colive">
            Co-Live
        </a>

        <a href="${pageContext.request.contextPath}/about">
            About
        </a>

        <a href="${pageContext.request.contextPath}/contact">
            Contact
        </a>

        <a href="${pageContext.request.contextPath}/owner/login">
            Owner Login
        </a>

    </nav>

</header>


<!-- =====================================================
     HERO
===================================================== -->

<section class="hero-section">

    <h2>Contact GetHostel</h2>

    <p>
        Have a question? We are here to help.
    </p>

</section>


<!-- =====================================================
     CONTACT CONTENT
===================================================== -->

<section class="about">

    <h2>Get In Touch</h2>

    <p>
        If you have any questions about hostels,
        hostel listings, owner registration or
        anything related to GetHostel, feel free
        to contact us.
    </p>


    <div class="contact-info-container">


        <!-- PHONE -->

        <div class="contact-info-card">

            <div class="contact-icon">
                📞
            </div>

            <h3>Phone</h3>

            <p>
                Contact us for assistance regarding
                hostel listings and services.
            </p>

            <a href="tel:+919999999999">
                +91 99999 99999
            </a>

        </div>


        <!-- EMAIL -->

        <div class="contact-info-card">

            <div class="contact-icon">
                ✉️
            </div>

            <h3>Email</h3>

            <p>
                Send us your questions or feedback
                through email.
            </p>

            <a href="mailto:support@gethostel.com">
                support@gethostel.com
            </a>

        </div>


        <!-- LOCATION -->

        <div class="contact-info-card">

            <div class="contact-icon">
                📍
            </div>

            <h3>Location</h3>

            <p>
                Hyderabad, Telangana, India
            </p>

        </div>

    </div>

</section>


<!-- =====================================================
     SUPPORT
===================================================== -->

<section class="about">

    <h2>How Can We Help?</h2>

    <p>
        <strong>For Users:</strong>
        If you are looking for a hostel and have
        questions about a listing, please contact
        the respective hostel owner using the
        information provided on the hostel card.
    </p>

    <p>
        <strong>For Hostel Owners:</strong>
        If you need assistance with registration,
        adding your hostel or updating your hostel
        information, you can contact our support team.
    </p>

    <p>
        <strong>Feedback:</strong>
        We value your feedback. If you have suggestions
        that can help us improve GetHostel, please
        share them with us.
    </p>

</section>


<!-- =====================================================
     CONTACT CTA
===================================================== -->

<section class="about about-contact">

    <h2>We're Happy to Help</h2>

    <p>
        Your questions and feedback help us improve
        the GetHostel experience.
    </p>

    <a href="mailto:support@gethostel.com"
       class="about-contact-button">

        Email Us

    </a>

</section>


<!-- =====================================================
     FOOTER
===================================================== -->

<footer>

    © 2026 AU Private Limited. All Rights Reserved.

</footer>


</body>

</html>